# MarketMind Environment Configuration Example

# Application
APP_NAME=MarketMind
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_STR=/api/v1
SECRET_KEY=change_this_to_a_secure_random_key_in_production

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (PostgreSQL / SQLite fallback for local testing)
# Default is SQLite for instant zero-dependency local dev, or PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://marketmind_user:marketmind_password@localhost:5432/marketmind_db
DATABASE_URL=sqlite:///./marketmind.db

# Storage Paths
DATA_DIR=./data
MODEL_ARTIFACTS_DIR=./models/artifacts

# Model Defaults
RANDOM_SEED=42
DEFAULT_PREDICTION_HORIZON=1
